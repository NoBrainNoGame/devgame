# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Matches docker-compose.yml (host port 5443; the lower ones are usually taken).
DATABASE_URL="postgresql://devgame:devgame@localhost:5443/devgame?schema=public"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Optional: Google OAuth. Leave empty to hide the Google sign-in button.
# Required in production unless you wire an email provider into sendMagicLink
# in src/lib/auth.ts — otherwise nobody can sign in to the deployed app.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# Bearer secret for every route under /api/cron. Generate with:
#   openssl rand -hex 32
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Game
# ---------------------------------------------------------------------------
# Keys the daily seed (HMAC of the UTC date). Generate with:
#   openssl rand -hex 32
DAILY_SEED_SECRET=""
