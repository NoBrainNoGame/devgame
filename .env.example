# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Matches docker-compose.yml (host port 5443; the lower ones are usually taken).
DATABASE_URL="postgresql://devgame:devgame@localhost:5443/devgame?schema=public"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Google OAuth — the primary way people sign in.
#
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID, type "Web application") and register the redirect URI:
#
#   http://localhost:3000/api/auth/callback/google      (development)
#   https://your-domain/api/auth/callback/google        (production)
#
# Leaving these empty hides the Google button. It is then the magic link or
# nothing — and no email provider is wired into sendMagicLink in
# src/lib/auth.ts, so in production that means nobody can sign in at all.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# Bearer secret for every route under /api/cron. Generate with:
#   openssl rand -hex 32
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Game
# ---------------------------------------------------------------------------
# Keys the daily seed (HMAC of the UTC date). Generate with:
#   openssl rand -hex 32
DAILY_SEED_SECRET=""
