# The development configuration. `bun run init` copies this file to `.env`
# when there is none, fills every empty secret below with a random value, and
# leaves an existing `.env` alone. Every variable the server reads is
# validated in src/lib/env.ts; that file is the reference for what each means.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The switch: set, the server side exists and needs its secrets; unset, the
# app runs offline with a local save only.
# Matches docker-compose.yml (host port 5443; the lower ones are usually taken).
DATABASE_URL="postgresql://devgame:devgame@localhost:5443/devgame?schema=public"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------
# Empty: `bun run init` draws one. By hand: openssl rand -hex 32
# Rotate it and every session ends.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Google OAuth — the primary way people sign in.
#
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID, type "Web application") and register the redirect URI:
#
#   http://localhost:3000/api/auth/callback/google      (development)
#   https://your-domain/api/auth/callback/google        (production)
#
# Leaving these empty hides the Google button. It is then the magic link or
# nothing — in development the link is printed to the server log; in
# production no email provider is wired into sendMagicLink in
# src/lib/auth.ts, so nobody can sign in at all.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# Bearer secret for every route under /api/cron; those routes are off without
# it. Empty: `bun run init` draws one. By hand: openssl rand -hex 32
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Game
# ---------------------------------------------------------------------------
# Keys the daily seed (HMAC of the UTC date). Rotate it and every future daily
# changes; past ones are kept. Empty: `bun run init` draws one. By hand:
#   openssl rand -hex 32
DAILY_SEED_SECRET=""

# ---------------------------------------------------------------------------
# Local admin panel (`bun run admin`, started with the database)
# ---------------------------------------------------------------------------
# Its password (at least 12 characters; the panel stays off without one) and
# the port it listens on, on this machine only. Empty: `bun run init` draws one.
# By hand: openssl rand -hex 16
ADMIN_PASSWORD=""
ADMIN_PORT=3100
