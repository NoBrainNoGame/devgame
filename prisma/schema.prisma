// Devgame schema: authentication, player profiles, runs and the leaderboard.
//
// Better Auth owns `user` / `session` / `account` / `verification`. Keeping them
// in our own Postgres is what lets application tables reference `User` with a
// real foreign key. After enabling a Better Auth plugin, regenerate with
//   bun x @better-auth/cli@latest generate
// and apply the diff as a migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Game
// ---------------------------------------------------------------------------

enum RunMode {
  classic
  daily
}

enum RunStatus {
  in_progress
  finished
  abandoned
  rejected
}

/// Meta-progression, one row per user. It lives here rather than on `user` so
/// that regenerating the Better Auth schema never has to know about game state.
///
/// `metaVersion` is an optimistic lock: the client sends back the version it
/// merged from, and a mismatch means another device wrote in between.
model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  displayName  String   @db.VarChar(24)
  level        Int      @default(1)
  xp           Int      @default(0)
  commitsBank  Int      @default(0)
  totalCommits Int      @default(0)
  ticketsDelivered Int      @default(0)
  /// { unlockedProfiles, unlockedSkills } — validated by the shared meta DTO.
  unlocks      Json     @default("{}")
  /// { settings, statPoints, unspentStatPoints, version } — same DTO.
  settings     Json     @default("{}")
  metaVersion  Int      @default(1)
  /// Set by an administrator. A banned player keeps the account and the game,
  /// and loses the board and the bug reports: nothing they submit is scored.
  bannedAt     DateTime?
  banReason    String?  @db.VarChar(200)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs Run[]
}

/// A run is its seed plus the ordered list of player actions. The score is
/// never taken from the client: `submitRun` replays the log server-side and
/// writes what the engine computed.
model Run {
  id               String    @id @default(cuid())
  profileId        String
  mode             RunMode
  seed             String    @db.VarChar(64)
  /// Set iff mode = daily. Dated in UTC.
  dailyDate        DateTime? @db.Date
  status           RunStatus @default(in_progress)
  /// Engine save version the actions were recorded with.
  version          Int
  /// Rules epoch the run was played under. The boards filter on it, because a
  /// score from before a rules change describes a different game.
  rulesEpoch       Int       @default(0)
  /// The whole `RunSaveDto`, verbatim. The columns around it are for querying;
  /// this is the record, and it is what gets replayed. Storing only the action
  /// list would lose the starter profile and the unlocks that shaped the map,
  /// and a replay without those is a different game.
  save             Json
  score            Int       @default(0)
  sprintsCompleted Int       @default(0)
  ticketsDelivered Int       @default(0)
  commits          Int       @default(0)
  /// Idempotency key generated by the client when the run starts.
  clientRunId      String    @unique
  /// Fingerprint of seed + actions. The client picks `clientRunId`, so this is
  /// what actually stops one good run being submitted over and over for credit.
  fingerprint      String    @db.VarChar(32)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  finishedAt       DateTime?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Resuming: the one run still in progress for this player.
  @@index([profileId, status])
  // Classic leaderboard.
  @@index([rulesEpoch, mode, status, score(sort: Desc), finishedAt])
  // Daily leaderboard.
  @@index([rulesEpoch, dailyDate, status, score(sort: Desc)])
  // Duplicate detection. Not unique here: an abandoned run and the finished
  // submission of the same game legitimately share a fingerprint. The partial
  // unique index that covers finished runs is hand-written — see
  // `prisma/migrations/00000000000002_run_unique_fingerprint`.
  @@index([profileId, fingerprint])
}

/// Page views, a day at a time. No visitor in it at all: a day, a page, a
/// language, and two counts — views, and visits (the first view of a browser
/// tab). No cookie, no address, no identifier is read or kept to fill it.
model VisitDay {
  day    DateTime @db.Date
  path   String   @db.VarChar(64)
  locale String   @db.VarChar(8)
  views  Int      @default(0)
  visits Int      @default(0)

  @@id([day, path, locale])
}

enum ReportStatus {
  open
  acknowledged
  closed
}

/// A bug a signed-in player reported. Plain text, rendered as text: what is
/// typed is stored, never interpreted.
model BugReport {
  id        String       @id @default(cuid())
  userId    String
  title     String       @db.VarChar(120)
  body      String       @db.VarChar(4000)
  /// The page it happened on, as the site names its routes.
  page      String?      @db.VarChar(64)
  /// The run's seed, when the player gives it.
  seed      String?      @db.VarChar(64)
  status    ReportStatus @default(open)
  /// An administrator's note; never shown to the player.
  note      String?      @db.VarChar(1000)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

/// Memoised daily seeds. Deriving is a pure HMAC of the date, but storing the
/// result keeps yesterday's boards stable if `DAILY_SEED_SECRET` ever rotates.
model DailySeed {
  date      DateTime @id @db.Date
  seed      String   @db.VarChar(64)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Better Auth
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  profile  Profile?
  reports  BugReport[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
